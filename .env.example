APP_NAME="IKA COMPTEUR"
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://127.0.0.1:8000

SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_MINUTES=480
PASSWORD_RESET_EXPIRE_MINUTES=30
# Cookies Secure : vide = automatique (true en production, false sinon)
COOKIE_SECURE=
# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=127.0.0.1,localhost
# Origines CORS autorisées (séparées par des virgules ; vide = APP_BASE_URL)
CORS_ORIGINS=

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ika_compteur
# Tests uniquement (facultatif) : vide = base de DATABASE_URL suffixée par « _test » (ika_compteur_test)
TEST_DATABASE_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM=no-reply@ikacompteur.com
MAIL_FROM_NAME="IKA COMPTEUR"

FIRST_ADMIN_EMAIL=admin@ikacompteur.com
FIRST_ADMIN_PASSWORD=Admin@2026
FIRST_ADMIN_NAME="Administrateur IKA"
